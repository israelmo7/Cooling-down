# Local Dart run: copy this file to .env.
# On a shop computer, edit shop.json instead. apply.sh writes .env from it.
# The admin page can change the mail fields. The token and admin password stay in .env.

PORT=8080
DATA_PATH=cooling_down_server.sqlite

SYNC_TOKEN=
ADMIN_USER=
ADMIN_PASSWORD=

OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
