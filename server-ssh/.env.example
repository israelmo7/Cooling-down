# Local Dart run: copy this file to .env.
# On a shop computer, edit shop.json instead. apply.sh writes .env from it.
# The admin page can change the owner email, the clock, the report choice, and the admin login.
# The sending mailbox and the token stay in this file.

PORT=8080
DATA_PATH=cooling_down_server.sqlite

SYNC_TOKEN=
ADMIN_USER=
ADMIN_PASSWORD=

OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

TZ=Asia/Jerusalem
REPORT_TIME=00:00
REPORT_FORMAT=builtin
