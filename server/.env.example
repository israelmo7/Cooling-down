# Shop computer. Copy this file to .env and fill it in.
# The admin page can change the mail fields. The token and admin password stay here.
# The Docker install keeps this file in cooling-down/data/.env on the shop computer.
# There, the container uses port 8080 and stores the database beside this file.

PORT=8080
DATA_PATH=cooling_down_server.sqlite

SYNC_TOKEN=
ADMIN_USER=
ADMIN_PASSWORD=

OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
